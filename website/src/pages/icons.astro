---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IconGrid from '../components/IconGrid.astro';
import Layout from '../layouts/Layout.astro';
import {
  breadcrumbNode,
  categories,
  categoryPath,
  collectionPageNode,
  hubDescription,
  hubTitle,
  interactionPath,
  interactions,
} from '../lib/hubs';
import { icons, INTERACTIONS } from '../lib/icons';
import { websiteNode } from '../lib/seo';

// The index of every icon page, grouped like the home page; plain links, no scripts.
const groups = categories();
const title = hubTitle(`All ${icons.length} animated icons by category`, `All ${icons.length} animated icons`);
const description = hubDescription(
  `Every useAnimations icon on one page: ${icons.length} free animated icons in ${groups.length} categories, for React, shadcn/ui, Lottie JSON and SVG. MIT licensed.`
);
const crumbs = [{ name: 'Icons', path: '/icons' }];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    collectionPageNode('/icons', 'All animated icons', description, icons),
    breadcrumbNode(crumbs),
    websiteNode(),
  ],
};
---

<Layout title={title} description={description} path="/icons" jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
    <header class="max-w-3xl">
      <Breadcrumbs crumbs={crumbs} />
      <p class="mt-8 text-sm font-medium text-accent">{icons.length} icons · MIT licensed</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">All animated icons</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Every icon in the set, grouped by category. Open one for a live preview, its React and shadcn/ui code, and
        the Lottie JSON, SVG and ZIP downloads. To search by keyword and try the animations in place, use the{' '}
        <a href="/#icons" class="text-fg underline underline-offset-4">icon browser</a>.
      </p>
    </header>

    <nav aria-label="Categories" class="mt-10 flex flex-wrap gap-2">
      {
        groups.map(({ meta, icons: group }) => (
          <a href={`#${meta.slug}`} class="inline-flex rounded-full border border-line px-3.5 py-1.5 text-sm text-muted transition hover:border-line-strong hover:text-fg">
            {meta.name} <span class="ml-1.5 text-subtle">{group.length}</span>
          </a>
        ))
      }
    </nav>
    <p class="mt-4 text-sm text-muted">
      By interaction:{' '}
      {
        interactions().map(({ interaction, icons: group }, index) => (
          <>
            {index > 0 && ' · '}
            <a href={interactionPath(interaction)} class="text-fg underline-offset-4 hover:underline">
              {INTERACTIONS[interaction].label}
            </a>{' '}
            <span class="text-subtle">({group.length})</span>
          </>
        ))
      }
    </p>

    {
      groups.map(({ meta, icons: group }) => (
        <section id={meta.slug} class="mt-14 scroll-mt-24" aria-labelledby={`${meta.slug}-title`}>
          <div class="flex flex-wrap items-baseline justify-between gap-3">
            <h2 id={`${meta.slug}-title`} class="text-2xl font-semibold tracking-tight">
              <a href={categoryPath(meta)} class="hover:underline hover:underline-offset-4">{meta.name}</a>
            </h2>
            <a href={categoryPath(meta)} class="text-sm text-muted hover:text-fg">
              {group.length} {meta.name.toLowerCase()} icons →
            </a>
          </div>
          <IconGrid class="mt-4" icons={group} />
        </section>
      ))
    }
  </div>
</Layout>
