---
import type { GetStaticPaths } from 'astro';
import { type Locale, TRANSLATED } from '../../i18n';
import DocumentationPage from '../../views/DocumentationPage.astro';

export const getStaticPaths = (() =>
  TRANSLATED.map((locale) => ({ params: { locale: locale.code }, props: { locale } }))) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
---

<DocumentationPage locale={locale} />
