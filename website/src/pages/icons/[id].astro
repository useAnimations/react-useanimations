---
import type { GetStaticPaths } from 'astro';
import CodeBlock from '../../components/CodeBlock.astro';
import IconPreview from '../../components/IconPreview';
import Layout from '../../layouts/Layout.astro';
import {
  filesExample,
  type Icon,
  icons,
  INTERACTIONS,
  reactExample,
  shadcnCommand,
  shadcnExample,
  SITE,
  urls,
} from '../../lib/icons';

export const getStaticPaths = (() =>
  icons.map((icon, index) => ({
    params: { id: icon.id },
    props: { icon, previous: icons[index - 1], next: icons[index + 1] },
  }))) satisfies GetStaticPaths;

const { icon, previous, next } = Astro.props as { icon: Icon; previous?: Icon; next?: Icon };
const u = urls(icon);
const related = icons.filter((other) => other.category === icon.category && other.id !== icon.id).slice(0, 12);
const kb = (Buffer.byteLength(icon.lottie) / 1024).toFixed(1);
const facts = [
  ['Interaction', INTERACTIONS[icon.interaction].label],
  ['Duration', `${(icon.durationMs / 1000).toFixed(2)} s`],
  ['Artboard', `${icon.width} × ${icon.height} px`],
  ['Lottie size', `${kb} kB`],
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ImageObject',
      name: `${icon.title} animated icon`,
      description: `Animated ${icon.title.toLowerCase()} icon (${icon.interaction}) from useAnimations, free under the MIT license.`,
      contentUrl: u.lottie,
      thumbnailUrl: u.svg[0],
      license: 'https://opensource.org/license/mit/',
      acquireLicensePage: `${SITE}/licencing-and-terms`,
      keywords: icon.keywords.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Icons', item: `${SITE}/#icons` },
        { '@type': 'ListItem', position: 2, name: icon.category, item: `${SITE}/?category=${encodeURIComponent(icon.category)}#icons` },
        { '@type': 'ListItem', position: 3, name: icon.title, item: u.page },
      ],
    },
  ],
};
---

<Layout
  title={`${icon.title} animated icon — useAnimations`}
  description={`Free animated ${icon.title.toLowerCase()} icon (${INTERACTIONS[icon.interaction].label.toLowerCase()}) for React and shadcn/ui. Download the SVG, Lottie JSON or ZIP. MIT licensed.`}
  path={`/icons/${icon.id}`}
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <a href="/#icons" class="hover:text-fg">Icons</a>
      <span class="mx-1.5 text-subtle">/</span>
      <a href={`/?category=${encodeURIComponent(icon.category)}#icons`} class="hover:text-fg">{icon.category}</a>
      <span class="mx-1.5 text-subtle">/</span>
      <span class="text-fg">{icon.title}</span>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,26rem)_1fr]">
      <div>
        <IconPreview
          client:load
          lottie={icon.lottie}
          interaction={icon.interaction}
          title={icon.title}
        />
        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 rounded-3xl border border-line p-6 text-sm">
          {
            facts.map(([label, value]) => (
              <div>
                <dt class="text-subtle">{label}</dt>
                <dd class="mt-0.5 text-fg">{value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="min-w-0">
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{icon.title}</h1>
        <p class="mt-4 max-w-xl text-lg text-muted">
          {INTERACTIONS[icon.interaction].description} Free under the MIT license.
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          {icon.keywords.map((keyword) => <span class="rounded-full bg-surface-2 px-3 py-1 text-xs text-muted">{keyword}</span>)}
        </div>

        <div class="mt-8 flex flex-wrap gap-2">
          <a
            href={`/icons/${icon.id}.zip`}
            download
            data-umami-event="download"
            data-umami-event-icon={icon.id}
            data-umami-event-format="zip"
            class="rounded-full bg-fg px-5 py-2.5 text-sm font-medium text-bg hover:opacity-85">Download ZIP</a
          >
          <a
            href={`/icons/${icon.id}.json`}
            download
            data-umami-event="download"
            data-umami-event-icon={icon.id}
            data-umami-event-format="json"
            class="rounded-full border border-line-strong px-5 py-2.5 text-sm hover:bg-surface-2">Lottie JSON</a
          >
          {
            Object.keys(icon.svgs).map((state) => (
              <a
                href={`/icons/${icon.id}/${state}.svg`}
                download
                data-umami-event="download"
                data-umami-event-icon={icon.id}
                data-umami-event-format="svg"
                class="rounded-full border border-line-strong px-5 py-2.5 text-sm hover:bg-surface-2"
              >
                {Object.keys(icon.svgs).length > 1 ? `${state}.svg` : 'SVG'}
              </a>
            ))
          }
        </div>

        <h2 class="mt-12 text-lg font-semibold">React</h2>
        <CodeBlock class="mt-3" lang="bash" code="npm install react-useanimations" />
        <CodeBlock class="mt-3" lang="jsx" code={reactExample(icon.exportName, icon.name)} />

        <h2 class="mt-10 text-lg font-semibold">shadcn/ui</h2>
        <CodeBlock class="mt-3" lang="bash" code={shadcnCommand(icon)} />
        <CodeBlock class="mt-3" lang="tsx" code={shadcnExample(icon.id, icon.component)} />

        <h2 class="mt-10 text-lg font-semibold">Files</h2>
        <CodeBlock class="mt-3" lang="bash" code={filesExample(icon.id)} />
        <p class="mt-3 text-sm text-muted">
          The animation as Lottie JSON and a ZIP with it and the SVGs. See{' '}
          <a class="underline underline-offset-4" href="/documentation#files--iconsjson">Files & icons.json</a>.
        </p>

        {
          Object.keys(icon.svgs).length > 0 && (
            <>
              <h2 class="mt-10 text-lg font-semibold">Static SVG</h2>
              <div class="mt-3 flex flex-wrap gap-3">
                {Object.entries(icon.svgs).map(([state, svg]) => (
                  <figure class="flex flex-col items-center gap-2 rounded-2xl border border-line p-4">
                    <span class="block size-10 [&_svg]:size-full" set:html={svg} />
                    <figcaption class="font-mono text-xs text-subtle">{state}.svg</figcaption>
                  </figure>
                ))}
              </div>
            </>
          )
        }
      </div>
    </div>

    {
      related.length > 0 && (
        <section class="mt-20" aria-labelledby="related-title">
          <h2 id="related-title" class="text-lg font-semibold">
            More in {icon.category}
          </h2>
          <ul class="mt-4 grid grid-cols-[repeat(auto-fill,minmax(7.5rem,1fr))] gap-3">
            {related.map((other) => (
              <li>
                <a
                  href={`/icons/${other.id}`}
                  class="flex aspect-[1/1.08] flex-col items-center justify-center gap-3 rounded-2xl border border-line bg-surface text-[13px] text-muted transition hover:border-line-strong hover:text-fg"
                >
                  <span data-useanimations="" class="block size-10 text-fg" set:html={other.firstFrame} />
                  {other.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav aria-label="Other icons" class="mt-16 flex justify-between gap-4 border-t border-line pt-6 text-sm">
      {previous ? <a href={`/icons/${previous.id}`} class="text-muted hover:text-fg">← {previous.title}</a> : <span />}
      {next && <a href={`/icons/${next.id}`} class="text-muted hover:text-fg">{next.title} →</a>}
    </nav>
  </div>
</Layout>
