---
import type { GetStaticPaths } from 'astro';
import IconPreview from '../../components/IconPreview';
import IconUsageTabs from '../../components/IconUsageTabs.astro';
import Layout from '../../layouts/Layout.astro';
import { lastModifiedOf } from '../../lib/git';
import { type Icon, icons, INTERACTIONS, reactExample, SITE, urls } from '../../lib/icons';
import {
  faqNode,
  iconDescription,
  iconFaq,
  iconIntro,
  iconTitle,
  meaningfulKeywords,
  ORGANIZATION_ID,
  organizationNode,
  related as relatedIcons,
  synonyms,
  variantFamily,
  variantNote,
  WEBSITE_ID,
  websiteNode,
} from '../../lib/seo';
import { GITHUB } from '../../lib/site';
import { CATEGORY_META, INTERACTION_META } from '../../lib/taxonomy';

export const getStaticPaths = (() =>
  icons.map((icon, index) => ({
    params: { id: icon.id },
    props: { icon, previous: icons[index - 1], next: icons[index + 1] },
  }))) satisfies GetStaticPaths;

const { icon, previous, next } = Astro.props as { icon: Icon; previous?: Icon; next?: Icon };
const u = urls(icon);
const title = iconTitle(icon);
const description = iconDescription(icon);
const category = CATEGORY_META[icon.category];
const interaction = INTERACTION_META[icon.interaction];
const categoryHref = `/categories/${category.slug}`;
const interactionHref = `/interactions/${interaction.slug}`;
const family = variantFamily(icon);
const related = relatedIcons(icon, 12 + family.length)
  .filter((other) => !family.includes(other))
  .slice(0, 12);
const aka = synonyms(icon);
const tags = meaningfulKeywords(icon).filter((keyword) => !aka.includes(keyword.toLowerCase()));
const faq = iconFaq(icon);
const states = Object.keys(icon.svgs);
const kb = (Buffer.byteLength(icon.lottie) / 1024).toFixed(1);
const facts: { label: string; value: string; href?: string }[] = [
  { label: 'Interaction', value: INTERACTIONS[icon.interaction].label, href: interactionHref },
  { label: 'Category', value: icon.category, href: categoryHref },
  { label: 'Duration', value: `${(icon.durationMs / 1000).toFixed(2)} s` },
  { label: 'Frame rate', value: `${Number(icon.fps.toFixed(2))} fps` },
  { label: 'Artboard', value: `${icon.width} × ${icon.height} px` },
  { label: 'Lottie size', value: `${kb} kB` },
];
const imageAlt = `${icon.title} animated icon from useAnimations`;
const modified = lastModifiedOf([`icons/${icon.name}.json`]);
const license = 'https://opensource.org/license/mit/';
const pageId = `${u.page}#page`;
const imageId = `${u.page}#image`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    organizationNode(),
    websiteNode(),
    {
      '@type': 'ItemPage',
      '@id': pageId,
      url: u.page,
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': WEBSITE_ID },
      about: { '@id': imageId },
      primaryImageOfPage: { '@id': imageId },
      breadcrumb: { '@id': `${u.page}#breadcrumb` },
      ...(modified && { dateModified: modified.slice(0, 10) }),
    },
    {
      '@type': 'ImageObject',
      '@id': imageId,
      name: `${icon.title} animated icon`,
      description: iconIntro(icon),
      contentUrl: u.svg[0] ?? u.og,
      encodingFormat: u.svg.length ? 'image/svg+xml' : 'image/png',
      thumbnailUrl: u.og,
      creator: { '@id': ORGANIZATION_ID },
      publisher: { '@id': ORGANIZATION_ID },
      creditText: 'useAnimations',
      copyrightNotice: '© useAnimations, released under the MIT License',
      license,
      acquireLicensePage: `${SITE}/licencing-and-terms`,
      keywords: [...new Set([icon.title.toLowerCase(), ...tags, ...aka])].join(', '),
    },
    {
      '@type': 'MediaObject',
      '@id': `${u.page}#lottie`,
      name: `${icon.title} Lottie animation`,
      contentUrl: u.lottie,
      encodingFormat: 'application/json',
      width: icon.width,
      height: icon.height,
      duration: `PT${Number((icon.durationMs / 1000).toFixed(2))}S`,
      contentSize: `${kb} kB`,
      creator: { '@id': ORGANIZATION_ID },
      license,
    },
    {
      '@type': 'SoftwareSourceCode',
      '@id': `${u.page}#react`,
      name: `${icon.title} animated icon in React`,
      programmingLanguage: 'TSX',
      runtimePlatform: 'React',
      codeRepository: GITHUB,
      license,
      text: reactExample(icon.exportName, icon.name),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${u.page}#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Icons', item: `${SITE}/icons` },
        { '@type': 'ListItem', position: 2, name: icon.category, item: `${SITE}${categoryHref}` },
        { '@type': 'ListItem', position: 3, name: icon.title, item: u.page },
      ],
    },
    { '@id': `${u.page}#faq`, ...faqNode(faq) },
  ],
};
---

<Layout
  title={title}
  description={description}
  path={`/icons/${icon.id}`}
  jsonLd={jsonLd}
  image={`/og/icons/${icon.id}.png`}
  imageAlt={imageAlt}
  markdown={`/icons/${icon.id}.md`}
>
  <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
    <nav aria-label="Breadcrumb" class="text-sm text-muted">
      <ol class="flex flex-wrap items-center">
        <li><a href="/icons" class="hover:text-fg">Icons</a></li>
        <li><span class="mx-1.5 text-subtle" aria-hidden="true">›</span><a href={categoryHref} class="hover:text-fg">{icon.category}</a></li>
        <li><span class="mx-1.5 text-subtle" aria-hidden="true">›</span><span class="text-fg" aria-current="page">{icon.title}</span></li>
      </ol>
    </nav>

    <div class="mt-8 grid gap-10 lg:grid-cols-[minmax(0,26rem)_1fr]">
      <div>
        <IconPreview client:load lottie={icon.lottie} interaction={icon.interaction} title={icon.title} />
        <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-4 rounded-3xl border border-line p-6 text-sm">
          {
            facts.map(({ label, value, href }) => (
              <div>
                <dt class="text-subtle">{label}</dt>
                <dd class="mt-0.5 text-fg">
                  {href ? <a href={href} class="underline decoration-line-strong underline-offset-4 hover:decoration-fg">{value}</a> : value}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="min-w-0">
        <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{icon.title}</h1>
        <p class="mt-2 text-lg text-subtle">Animated {icon.title.toLowerCase()} icon</p>
        <p class="mt-4 max-w-xl text-lg text-muted">{iconIntro(icon)}</p>
        {
          aka.length > 0 && (
            <div class="mt-6 flex flex-wrap items-center gap-2 text-sm">
              <span class="text-subtle">Also known as</span>
              {aka.map((term) => (
                <span class="rounded-full bg-surface-2 px-3 py-1 text-xs text-muted">{term}</span>
              ))}
            </div>
          )
        }
        {
          tags.length > 0 && (
            <div class="mt-3 flex flex-wrap gap-2">
              {tags.map((keyword) => (
                <span class="rounded-full border border-line px-3 py-1 text-xs text-subtle">{keyword}</span>
              ))}
            </div>
          )
        }

        <div class="mt-8 flex flex-wrap gap-2">
          <a
            href={`/icons/${icon.id}.zip`}
            download
            data-track="download"
            data-track-icon={icon.id}
            data-track-format="zip"
            class="rounded-full bg-fg px-5 py-2.5 text-sm font-medium text-bg hover:opacity-85">Download ZIP</a
          >
          <a
            href={`/icons/${icon.id}.json`}
            download
            data-track="download"
            data-track-icon={icon.id}
            data-track-format="json"
            class="rounded-full border border-line-strong px-5 py-2.5 text-sm hover:bg-surface-2">Lottie JSON</a
          >
          {
            states.map((state) => (
              <a
                href={`/icons/${icon.id}/${state}.svg`}
                download
                data-track="download"
                data-track-icon={icon.id}
                data-track-format="svg"
                data-track-file={`${state}.svg`}
                class="rounded-full border border-line-strong px-5 py-2.5 text-sm hover:bg-surface-2"
              >
                {states.length > 1 ? `${state}.svg` : 'SVG'}
              </a>
            ))
          }
        </div>
        <p class="mt-3 text-sm text-subtle">
          Free under the <a class="underline underline-offset-4 hover:text-fg" href="/licencing-and-terms">MIT license</a> ·{' '}
          <a class="underline underline-offset-4 hover:text-fg" href={`/icons/${icon.id}.md`}>Markdown version</a> ·{' '}
          <a class="underline underline-offset-4 hover:text-fg" href="/documentation#files--iconsjson">About the files</a>
        </p>

        <h2 class="mt-12 text-lg font-semibold">Use it</h2>
        <div class="mt-3">
          <IconUsageTabs icon={icon} />
        </div>

        {
          states.length > 0 && (
            <>
              <h2 class="mt-10 text-lg font-semibold">Static SVG</h2>
              <div class="mt-3 flex flex-wrap gap-3">
                {states.map((state) => (
                  <figure class="flex flex-col items-center gap-2 rounded-2xl border border-line p-4">
                    <img
                      src={`/icons/${icon.id}/${state}.svg`}
                      alt={`${icon.title} icon, ${state} state`}
                      width="40"
                      height="40"
                      loading="lazy"
                      class="size-10 dark:invert"
                    />
                    <figcaption class="font-mono text-xs text-subtle">{state}.svg</figcaption>
                  </figure>
                ))}
              </div>
            </>
          )
        }
      </div>
    </div>

    {
      family.length > 0 && (
        <section class="mt-20" aria-labelledby="versions-title">
          <h2 id="versions-title" class="text-lg font-semibold">
            Other versions
          </h2>
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {family.map((other) => (
              <li>
                <a
                  href={`/icons/${other.id}`}
                  class="flex items-center gap-4 rounded-2xl border border-line bg-surface p-4 transition hover:border-line-strong"
                >
                  <span data-useanimations="" class="block size-10 shrink-0 text-fg" set:html={other.firstFrame} />
                  <span>
                    <span class="block text-sm font-medium text-fg">{other.title}</span>
                    <span class="mt-0.5 block text-sm text-muted">{variantNote(icon, other)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-20 max-w-3xl" aria-labelledby="faq-title">
      <h2 id="faq-title" class="text-lg font-semibold">Questions about the {icon.title} icon</h2>
      <div class="mt-4 divide-y divide-line border-y border-line">
        {
          faq.map(({ question, answer }) => (
            <details class="group py-4">
              <summary class="cursor-pointer list-none font-medium text-fg marker:hidden">
                <span class="mr-2 inline-block text-subtle transition group-open:rotate-90">›</span>
                {question}
              </summary>
              <p class="mt-2 pl-5 text-sm text-muted">{answer}</p>
            </details>
          ))
        }
      </div>
    </section>

    {
      related.length > 0 && (
        <section class="mt-20" aria-labelledby="related-title">
          <div class="flex flex-wrap items-baseline justify-between gap-4">
            <h2 id="related-title" class="text-lg font-semibold">
              Related icons
            </h2>
            <a href={categoryHref} class="text-sm text-muted hover:text-fg">
              All {icon.category.toLowerCase()} icons →
            </a>
          </div>
          <ul class="mt-4 grid grid-cols-[repeat(auto-fill,minmax(7.5rem,1fr))] gap-3">
            {related.map((other) => (
              <li>
                <a
                  href={`/icons/${other.id}`}
                  class="flex aspect-[1/1.08] flex-col items-center justify-center gap-3 rounded-2xl border border-line bg-surface text-[13px] text-muted transition hover:border-line-strong hover:text-fg"
                >
                  <span data-useanimations="" class="block size-10 text-fg" set:html={other.firstFrame} />
                  {other.title}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <nav aria-label="Other icons" class="mt-16 flex justify-between gap-4 border-t border-line pt-6 text-sm">
      {previous ? <a href={`/icons/${previous.id}`} class="text-muted hover:text-fg">← {previous.title}</a> : <span />}
      {next && <a href={`/icons/${next.id}`} class="text-muted hover:text-fg">{next.title} →</a>}
    </nav>
  </div>
</Layout>

<script>
  import '../../scripts/tabs';
</script>
