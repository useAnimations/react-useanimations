---
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CodeBlock from '../components/CodeBlock.astro';
import FaqList from '../components/FaqList.astro';
import IconGrid from '../components/IconGrid.astro';
import Layout from '../layouts/Layout.astro';
import { breadcrumbNode, categories, categoryPath, expressionIcons, hubDescription, hubTitle, itemListNode, pickIcons } from '../lib/hubs';
import { iconById, icons, lottieSnippet, SITE } from '../lib/icons';
import { type Faq, faqNode, websiteNode, WEBSITE_ID } from '../lib/seo';

const popular = pickIcons([
  'menu', 'refresh', 'notification', 'heart', 'visibility', 'trash', 'settings', 'search-to-x',
  'play-pause', 'volume', 'download', 'check-box', 'toggle', 'scroll-down', 'arrow-right', 'bookmark',
  'star', 'send', 'github', 'sun', 'infinity', 'alert-triangle', 'microphone', 'shopping-cart',
]);
const expressions = expressionIcons();
const sizes = icons.map((icon) => Buffer.byteLength(icon.lottie)).toSorted((a, b) => a - b);
const kb = (bytes: number) => `${Math.round(bytes / 1024)} kB`;
const median = kb(sizes[Math.floor(sizes.length / 2)]);
const loop = `${SITE}/icons/loading.json`;
const menu = iconById.get('menu')!;

const players = [
  {
    id: 'web',
    title: 'Web: lottie-web',
    text: 'The reference player from Airbnb. Load it from a CDN, point it at an icon URL and choose the SVG renderer, which keeps the icon sharp and lets CSS recolor it. Use the full build (lottie.min.js): the light build skips expressions.',
    blocks: [
      {
        lang: 'html',
        code: `<div id="icon" style="width: 48px; height: 48px"></div>

<script src="https://cdn.jsdelivr.net/npm/lottie-web@5.13.0/build/player/lottie.min.js"></script>
<script>
  lottie.loadAnimation({
    container: document.getElementById('icon'),
    renderer: 'svg',
    loop: true,
    autoplay: true,
    path: '${loop}',
  });
</script>`,
      },
      {
        lang: 'css',
        label: 'Follow the text color (SVG renderer)',
        code: `#icon path[stroke^='rgb']:not([stroke='rgb(255,255,255)']) { stroke: currentColor; }
#icon path[fill='rgb(0,0,0)'] { fill: currentColor; }`,
      },
    ],
  },
  {
    id: 'web-interactions',
    title: 'Web: hover and click interactions',
    text: `lottie-web plays and stops, but the interactions are up to you. This is the menu icon's click toggle with reduced-motion support; every interaction follows the same pattern, and the React component below does all of it for you.`,
    blocks: [
      {
        lang: 'js',
        code: `import lottie from 'lottie-web'; // npm install lottie-web

const el = document.querySelector('#menu-button');
${lottieSnippet(menu)}`,
      },
    ],
  },
  {
    id: 'dotlottie',
    title: 'Web: dotLottie web component',
    text: "LottieFiles' player renders with a WebAssembly engine to a canvas and plays plain Lottie JSON as well as .lottie files. A canvas keeps the colors of the file, so the icons stay black unless you recolor the JSON.",
    blocks: [
      {
        lang: 'html',
        code: `<script type="module" src="https://cdn.jsdelivr.net/npm/@lottiefiles/dotlottie-wc@0.10.0/dist/dotlottie-wc.js"></script>

<dotlottie-wc src="${loop}" autoplay loop style="width: 48px; height: 48px"></dotlottie-wc>`,
      },
      {
        lang: 'js',
        label: 'Or the JavaScript API: npm install @lottiefiles/dotlottie-web',
        code: `import { DotLottie } from '@lottiefiles/dotlottie-web';

new DotLottie({
  canvas: document.querySelector('#icon-canvas'),
  src: '${loop}',
  autoplay: true,
  loop: true,
});`,
      },
    ],
  },
  {
    id: 'react',
    title: 'React: react-useanimations',
    text: 'No Lottie player to install: the package has its own 8 kB player, plays each icon’s interaction, follows the text color and respects reduced motion. Each icon is a separate module, so you only ship the ones you import.',
    blocks: [
      {
        lang: 'jsx',
        code: `// npm install react-useanimations
import UseAnimations from 'react-useanimations';
import loading from 'react-useanimations/lib/loading';

<UseAnimations animation={loading} size={48} />`,
      },
    ],
  },
  {
    id: 'react-native',
    title: 'React Native: lottie-react-native',
    text: 'Bundle the JSON with require() for offline use, or load it from its URL.',
    blocks: [
      {
        lang: 'jsx',
        code: `// npm install lottie-react-native
import LottieView from 'lottie-react-native';

<LottieView
  source={{ uri: '${loop}' }} // or require('./loading.json')
  autoPlay
  loop
  style={{ width: 48, height: 48 }}
/>`,
      },
    ],
  },
  {
    id: 'ios',
    title: 'iOS: lottie-ios (SwiftUI)',
    text: 'Add the package from https://github.com/airbnb/lottie-spm.git with Swift Package Manager, then drop the JSON into your bundle or load it from its URL.',
    blocks: [
      {
        lang: 'swift',
        code: `import Lottie
import SwiftUI

struct LoadingIcon: View {
  var body: some View {
    // Bundled file: LottieView(animation: .named("loading"))
    LottieView {
      await LottieAnimation.loadedFrom(url: URL(string: "${loop}")!)
    }
    .looping()
    .frame(width: 48, height: 48)
  }
}`,
      },
    ],
  },
  {
    id: 'android',
    title: 'Android: lottie-android (Jetpack Compose)',
    text: 'Add com.airbnb.android:lottie-compose (or com.airbnb.android:lottie for views). Put the JSON in res/raw for offline use with LottieCompositionSpec.RawRes.',
    blocks: [
      {
        lang: 'kotlin',
        code: `// build.gradle.kts: implementation("com.airbnb.android:lottie-compose:6.7.1")
@Composable
fun LoadingIcon() {
  val composition by rememberLottieComposition(
    LottieCompositionSpec.Url("${loop}")
  )
  LottieAnimation(
    composition = composition,
    iterations = LottieConstants.IterateForever,
    modifier = Modifier.size(48.dp),
  )
}`,
      },
    ],
  },
  {
    id: 'flutter',
    title: 'Flutter: lottie',
    text: 'The lottie package is a pure Dart player for Android, iOS, web and desktop.',
    blocks: [
      {
        lang: 'dart',
        code: `// pubspec.yaml: lottie: ^3.6.1
import 'package:lottie/lottie.dart';

Lottie.network(
  '${loop}',
  width: 48,
  height: 48,
) // or Lottie.asset('assets/loading.json')`,
      },
    ],
  },
];

const faq: Faq = [
  {
    question: 'Are these Lottie icons free for commercial use?',
    answer: `Yes. All ${icons.length} Lottie icons are MIT-licensed: use, modify and redistribute them in personal and commercial projects, with no attribution required and no account to download them.`,
  },
  {
    question: 'What format are the Lottie files?',
    answer: `Standard Lottie JSON (the Bodymovin format) with shape layers only: no images, fonts or external assets. Each icon is drawn on a 24 or 32 px artboard, scales to any size and weighs ${kb(sizes[0])} to ${kb(sizes.at(-1)!)}, ${median} median.`,
  },
  {
    question: 'Do I need lottie-web to use the icons in React?',
    answer: 'No. react-useanimations has its own 8 kB player with no dependencies, so you install one package and import the icons you need. lottie-web is only needed outside React, on plain web pages or in other frameworks.',
  },
  {
    question: 'Which icons need the full lottie-web build?',
    answer: `${expressions.length} icons use After Effects expressions (loopOut or wiggle): ${expressions.map((icon) => icon.title).join(', ')}. On the web they need lottie-web's full build; lottie_light ignores expressions. Native players (lottie-ios, lottie-android, Flutter's lottie) do not evaluate expressions either, so these icons may move differently there.`,
  },
  {
    question: 'Can I change the color of a Lottie icon?',
    answer: "On the web, lottie-web's SVG renderer writes the colors as attributes, so a CSS rule on the paths recolors the icon. Native players use their dynamic property APIs: ColorValueProvider on iOS, LottieProperty.COLOR and STROKE_COLOR on Android, and ValueDelegate.color in Flutter.",
  },
];

const title = hubTitle(`Free Lottie icons: ${icons.length} animated JSON icons`, 'Free Lottie icons');
const description = hubDescription(
  `${icons.length} free Lottie icons as plain Lottie JSON, MIT licensed. Copy-paste code for lottie-web, dotLottie, React, React Native, iOS, Android and Flutter.`
);
const crumbs = [
  { name: 'Icons', path: '/icons' },
  { name: 'Lottie icons', path: '/lottie-icons' },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${SITE}/lottie-icons`,
      url: `${SITE}/lottie-icons`,
      name: 'Free Lottie icons',
      description,
      inLanguage: 'en',
      isPartOf: { '@id': WEBSITE_ID },
      mainEntity: itemListNode(popular, 'Popular Lottie icons'),
    },
    {
      '@type': 'Dataset',
      name: 'useAnimations icon catalog',
      description: `Metadata and file URLs of ${icons.length} animated Lottie icons: id, title, category, keywords, interaction, size and duration.`,
      url: `${SITE}/lottie-icons`,
      license: 'https://opensource.org/license/mit/',
      creator: { '@type': 'Organization', name: 'useAnimations', url: `${SITE}/` },
      distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE}/icons.json` }],
    },
    breadcrumbNode(crumbs),
    faqNode(faq),
    websiteNode(),
  ],
};
---

<Layout title={title} description={description} path="/lottie-icons" jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
    <Breadcrumbs crumbs={crumbs} />

    <header class="mt-8 max-w-3xl">
      <p class="text-sm font-medium text-accent">{icons.length} icons · Lottie JSON · MIT licensed</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">Free Lottie icons</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Every useAnimations icon is a standard Lottie JSON animation, so any Lottie player can play it: lottie-web on
        the web, lottie-ios, lottie-android, Flutter and React Native. The files are free under the MIT license, with
        no sign-up, and served from stable URLs with CORS enabled, so you can load them directly or download them into
        your project.
      </p>
    </header>

    <section class="mt-12" aria-labelledby="popular-title">
      <div class="flex flex-wrap items-baseline justify-between gap-3">
        <h2 id="popular-title" class="text-lg font-semibold">Popular Lottie icons</h2>
        <a href="/icons" class="text-sm text-muted hover:text-fg">All {icons.length} icons →</a>
      </div>
      <IconGrid class="mt-4" icons={popular} />
    </section>

    <div class="mt-16 max-w-3xl">
      <section aria-labelledby="files-title">
        <h2 id="files-title" class="text-2xl font-semibold tracking-tight">Files and URLs</h2>
        <p class="mt-3 leading-relaxed text-muted">
          Each icon has a page at <code class="font-mono text-sm text-fg">/icons/&lt;id&gt;</code> with a preview and
          downloads. The files themselves:
        </p>
        <CodeBlock
          class="mt-4"
          lang="bash"
          code={`${SITE}/icons/<id>.json          # Lottie JSON animation
${SITE}/icons/<id>.zip           # the JSON and static SVGs
${SITE}/icons/<id>/<state>.svg   # static SVG of each state
${SITE}/icons.json               # catalog of every icon`}
          track={{ code: 'files' }}
        />
        <p class="mt-4 leading-relaxed text-muted">
          <a href="/icons.json" class="text-fg underline underline-offset-4">icons.json</a> lists every icon with its id,
          title, category, keywords, interaction, size, duration and file URLs, which makes it easy to pick icons by
          keyword in a script or let a coding agent choose one. Lottie files weigh {median} at the median.
        </p>
      </section>

      {
        players.map((player) => (
          <section id={player.id} class="mt-14 scroll-mt-24" aria-labelledby={`${player.id}-title`}>
            <h2 id={`${player.id}-title`} class="text-2xl font-semibold tracking-tight">{player.title}</h2>
            <p class="mt-3 leading-relaxed text-muted">{player.text}</p>
            {player.blocks.map((block) => (
              <CodeBlock class="mt-4" lang={block.lang} label={block.label} code={block.code} track={{ code: `lottie-${player.id}` }} />
            ))}
          </section>
        ))
      }

      <section id="expressions" class="mt-14 scroll-mt-24" aria-labelledby="expressions-title">
        <h2 id="expressions-title" class="text-2xl font-semibold tracking-tight">Icons with expressions</h2>
        <p class="mt-3 leading-relaxed text-muted">
          {expressions.length} icons use After Effects expressions
          (<code class="font-mono text-sm text-fg">loopOut</code> or <code class="font-mono text-sm text-fg">wiggle</code>). On the web, play them with lottie-web's full build,
          not <code class="font-mono text-sm text-fg">lottie_light</code>. Native players do not evaluate expressions, so
          test these on iOS, Android and Flutter or pick another icon; react-useanimations plays them as designed.
        </p>
        <IconGrid class="mt-4" icons={expressions} />
      </section>
    </div>

    <FaqList class="mt-16" faq={faq} />

    <nav aria-labelledby="more-title" class="mt-16 border-t border-line pt-8">
      <h2 id="more-title" class="text-lg font-semibold">Lottie icons by category</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          categories().map(({ meta, icons: group }) => (
            <li>
              <a href={categoryPath(meta)} class="inline-flex rounded-full border border-line px-3.5 py-1.5 text-sm text-muted transition hover:border-line-strong hover:text-fg">
                {meta.name} <span class="ml-1.5 text-subtle">{group.length}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</Layout>
