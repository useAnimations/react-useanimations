---
import type { GetStaticPaths } from 'astro';
import type { Interaction } from 'react-useanimations';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import FaqList from '../../components/FaqList.astro';
import IconGrid from '../../components/IconGrid.astro';
import InteractionDemo from '../../components/InteractionDemo';
import Layout from '../../layouts/Layout.astro';
import {
  breadcrumbNode,
  categoryPath,
  collectionPageNode,
  interactionFaq,
  interactionPath,
  interactions,
  interactionText,
  pickIcons,
  plural,
  REDUCED_MOTION,
} from '../../lib/hubs';
import { INTERACTIONS } from '../../lib/icons';
import { faqNode, websiteNode } from '../../lib/seo';
import { iconsByInteraction, INTERACTION_META } from '../../lib/taxonomy';

export const getStaticPaths = (() =>
  interactions().map(({ interaction }) => ({ params: { slug: interaction }, props: { interaction } }))) satisfies GetStaticPaths;

const { interaction } = Astro.props as { interaction: Interaction };
const meta = INTERACTION_META[interaction];
const info = INTERACTIONS[interaction];
const items = iconsByInteraction(interaction);
const copy = interactionText(interaction);
const path = interactionPath(interaction);
const faq = interactionFaq(interaction);
const hover = interaction.startsWith('hover');
const crumbs = [
  { name: 'Icons', path: '/icons' },
  { name: 'Interactions', path: '/interactions' },
  { name: info.label, path },
];

// Another icon given this interaction with the prop.
const [other] = pickIcons(['settings', 'bookmark', 'star']).filter((icon) => icon.interaction !== interaction);
const ex = copy.example;
const imports = (icon: typeof ex) => `import ${icon.exportName} from 'react-useanimations/lib/${icon.name}';`;
const overrideCode = `import UseAnimations from 'react-useanimations';
${imports(other)}

// ${other.title} normally uses '${other.interaction}'
<UseAnimations animation={${other.exportName}} interaction="${interaction}" size={32} />`;

const extra: Record<Interaction, { text: string; code: string }> = {
  loop: {
    text: 'Loops autoplay and pause while scrolled out of view. Slow one down with speed, play it once with loop={false}, or keep it still with autoplay={false}:',
    code: `${imports(ex)}

<UseAnimations animation={${ex.exportName}} speed={0.5} />      // half speed
<UseAnimations animation={${ex.exportName}} loop={false} />     // plays once, then stops
<UseAnimations animation={${ex.exportName}} autoplay={false} /> // static first frame`,
  },
  'click-toggle': {
    text: 'Clicks toggle the icon on their own. To keep it in sync with your state, pass active: the icon animates whenever active changes, and clicks no longer toggle it by themselves.',
    code: `import { useState } from 'react';
${imports(ex)}

export function MenuButton() {
  const [open, setOpen] = useState(false);
  return (
    <UseAnimations
      animation={${ex.exportName}}
      active={open} // true shows the end state
      onClick={() => setOpen(!open)}
      aria-label={open ? 'Close menu' : 'Open menu'}
    />
  );
}`,
  },
  'click-replay': {
    text: 'Put the icon in a real button with the render prop, so it can be focused and announced. Your onClick runs first; call event.preventDefault() to skip the animation.',
    code: `${imports(ex)}

<UseAnimations
  animation={${ex.exportName}}
  size={24}
  onClick={handleDownload}
  render={(eventProps, animationProps) => (
    <button type="button" aria-label="Download" {...eventProps}>
      <span {...animationProps} />
    </button>
  )}
/>`,
  },
  hover: {
    text: 'Put the icon in a link or button with the render prop: the animation then also plays when the element gets keyboard focus, and taps on touch screens do not trigger it.',
    code: `${imports(ex)}

<UseAnimations
  animation={${ex.exportName}}
  render={(eventProps, animationProps) => (
    <a href="/archive" {...eventProps}>
      <span {...animationProps} /> Archive
    </a>
  )}
/>`,
  },
  'hover-replay': {
    text: 'Hover the whole card or link, not just the icon: with the render prop the events go on your element, and keyboard focus plays the animation too.',
    code: `${imports(ex)}

<UseAnimations
  animation={${ex.exportName}}
  render={(eventProps, animationProps) => (
    <a href="/reports" className="card" {...eventProps}>
      <span {...animationProps} /> Weekly growth
    </a>
  )}
/>`,
  },
  'hover-loop': {
    text: 'Use the render prop so the whole link triggers the loop, including keyboard focus. Change the pace with speed:',
    code: `${imports(ex)}

<UseAnimations
  animation={${ex.exportName}}
  speed={1.5}
  render={(eventProps, animationProps) => (
    <a href="https://github.com/useAnimations" aria-label="GitHub" {...eventProps}>
      <span {...animationProps} />
    </a>
  )}
/>`,
  },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    collectionPageNode(path, meta.title, copy.description, items),
    breadcrumbNode(crumbs),
    faqNode(faq),
    websiteNode(),
  ],
};
---

<Layout title={copy.title} description={copy.description} path={path} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
    <Breadcrumbs crumbs={crumbs} />

    <div class="mt-8 grid items-start gap-10 lg:grid-cols-[1fr_20rem]">
      <header class="max-w-3xl">
        <p class="text-sm font-medium text-accent">
          {plural(items.length, 'icon')} · <code class="font-mono">interaction="{interaction}"</code>
        </p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{meta.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">{meta.intro}</p>
      </header>
      <InteractionDemo
        client:visible
        id={ex.id}
        interaction={interaction}
        title={ex.title}
        description={info.description}
        hint={info.description}
      />
    </div>

    <section class="mt-12" aria-labelledby="icons-title">
      <h2 id="icons-title" class="text-lg font-semibold">All {info.label.toLowerCase()} icons</h2>
      <IconGrid class="mt-4" icons={items} />
    </section>

    <div class="mt-16 grid gap-12 lg:grid-cols-2">
      <section aria-labelledby="behaviour-title">
        <h2 id="behaviour-title" class="text-2xl font-semibold tracking-tight">How it behaves</h2>
        <p class="mt-4 leading-relaxed text-muted">{info.description}</p>
        <p class="mt-3 leading-relaxed text-muted">
          {REDUCED_MOTION[interaction]}
          {hover && ' Taps on touch screens do not start hover animations, and keyboard focus does when the icon is inside a focusable element.'}{' '}
          The React component handles all of this; you only pick the icon.
        </p>
        <h3 class="mt-8 font-semibold">Where to use it</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-muted marker:text-subtle">
          {meta.useCases.map((useCase) => <li>{useCase}</li>)}
        </ul>
      </section>

      <section aria-labelledby="by-category-title">
        <h2 id="by-category-title" class="text-2xl font-semibold tracking-tight">By category</h2>
        <ul class="mt-4 space-y-3">
          {
            copy.byCategory.map(({ meta: category, icons: group }) => (
              <li>
                <a href={categoryPath(category)} class="font-medium text-fg underline-offset-4 hover:underline">{category.name}</a>
                <span class="text-subtle"> · {group.length}</span>
                <p class="mt-0.5 text-sm text-muted">{group.map((icon) => icon.title).join(', ')}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <section class="mt-16 max-w-3xl" aria-labelledby="code-title">
      <h2 id="code-title" class="text-2xl font-semibold tracking-tight">Use it in React</h2>
      <p class="mt-3 leading-relaxed text-muted">
        Icons listed here play this interaction by default. Any other icon can use it too: pass the{' '}
        <code class="font-mono text-sm text-fg">interaction</code> prop.
      </p>
      <CodeBlock class="mt-4" lang="jsx" code={overrideCode} track={{ icon: other.id, code: 'interaction' }} />
      <p class="mt-6 leading-relaxed text-muted">{extra[interaction].text}</p>
      <CodeBlock class="mt-3" lang="jsx" code={extra[interaction].code} track={{ icon: ex.id, code: 'react' }} />
      <p class="mt-6 leading-relaxed text-muted">
        Every prop is in the <a class="text-fg underline underline-offset-4" href="/documentation#props">documentation</a>.
        Outside React, the icons are Lottie JSON files; <a class="text-fg underline underline-offset-4" href="/lottie-icons">Lottie icons</a>{' '}
        shows how to recreate the interactions with lottie-web.
      </p>
    </section>

    <FaqList class="mt-16" faq={faq} />

    <nav aria-labelledby="more-title" class="mt-16 border-t border-line pt-8">
      <h2 id="more-title" class="text-lg font-semibold">Other interactions</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          interactions()
            .filter((group) => group.interaction !== interaction)
            .map((group) => (
              <li>
                <a href={interactionPath(group.interaction)} class="inline-flex rounded-full border border-line px-3.5 py-1.5 text-sm text-muted transition hover:border-line-strong hover:text-fg">
                  {INTERACTIONS[group.interaction].label} <span class="ml-1.5 text-subtle">{group.icons.length}</span>
                </a>
              </li>
            ))
        }
        <li>
          <a href="/categories" class="inline-flex rounded-full bg-fg px-3.5 py-1.5 text-sm font-medium text-bg hover:opacity-85">Browse by category</a>
        </li>
      </ul>
    </nav>
  </div>
</Layout>
