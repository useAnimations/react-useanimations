---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle';
import NavIcon from './NavIcon';
import MobileMenu from './MobileMenu';
import { EN, type Locale, localize, t } from '../i18n';
import { GITHUB, nav } from '../lib/site';

interface Props {
  locale?: Locale;
}

const { locale = EN } = Astro.props;
const m = t(locale).common;
const islands = t(locale).islands;
const items = nav(locale);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/75 backdrop-blur-xl supports-[backdrop-filter]:bg-bg/60">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-6 px-5 sm:px-8">
    <a href={localize('/', locale)} class="shrink-0 rounded-lg" aria-label={m.homeLabel}>
      <Logo />
    </a>
    <span class="hidden rounded-full border border-line px-2 py-0.5 font-mono text-[11px] text-muted sm:inline">v3</span>
    <nav aria-label={m.mainNav} class="ml-4 hidden items-center gap-1 md:flex">
      {
        items.map((item) => (
          <a
            href={item.href}
            aria-current={path === item.href ? 'page' : undefined}
            class="rounded-lg px-3 py-2 text-sm text-muted transition-colors hover:bg-surface-2 hover:text-fg aria-[current=page]:text-fg"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex items-center gap-1.5">
      <NavIcon client:idle href={GITHUB} label="GitHub" />
      <ThemeToggle client:idle strings={islands.themeToggle} />
      <a
        href={localize('/#icons', locale)}
        class="ml-1.5 hidden rounded-full bg-fg px-4 py-2 text-sm font-medium text-bg transition hover:opacity-85 sm:inline-flex"
        >{m.browseIcons}</a
      >
      <MobileMenu client:idle items={items} strings={islands.mobileMenu} />
    </div>
  </div>
</header>
