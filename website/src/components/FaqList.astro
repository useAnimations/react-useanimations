---
import type { Faq } from '../lib/seo';

interface Props {
  faq: Faq;
  class?: string;
  /** Heading, in the page's language. */
  title?: string;
}

const { faq, class: className, title = 'FAQ' } = Astro.props;
---

<section class:list={['max-w-3xl', className]} aria-labelledby="faq-title">
  <h2 id="faq-title" class="text-2xl font-semibold tracking-tight">{title}</h2>
  <div class="mt-5 divide-y divide-line rounded-3xl border border-line">
    {
      faq.map(({ question, answer }) => (
        <details class="group px-6 py-4">
          <summary class="cursor-pointer font-medium text-fg">{question}</summary>
          <p class="mt-3 leading-relaxed text-muted">{answer}</p>
        </details>
      ))
    }
  </div>
</section>
