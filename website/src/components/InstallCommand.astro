---
import { EN, type Locale, t } from '../i18n';
import ControlIcon from './ControlIcon';

interface Props {
  command?: string;
  class?: string;
  /** Language of the button text. */
  locale?: Locale;
}
const { command = 'npm i react-useanimations', class: className, locale = EN } = Astro.props;
---

<button
  type="button"
  data-copy={command}
  data-track="copy"
  data-track-code="install"
  class:list={[
    'group inline-flex items-center gap-3 rounded-full border border-line-strong bg-surface/70 py-2.5 pr-3 pl-5 font-mono text-sm text-fg backdrop-blur transition hover:border-accent',
    className,
  ]}
>
  <!-- No aria-label: the name is the visible text ('npm i react-useanimations Copy'). -->
  <span class="text-subtle select-none" aria-hidden="true">$</span>
  <span>{command}</span>
  <span class="inline-flex items-center gap-1.5 rounded-full bg-surface-2 px-2.5 py-1 font-sans text-xs text-muted transition group-hover:text-fg">
    <ControlIcon client:idle icon="copy" size={14} />
    <span data-copy-label>{t(locale).common.copy}</span>
  </span>
</button>
