---
// An interaction page (/interactions/<interaction>) in any language; src/pages routes render it.
import type { Interaction } from 'react-useanimations';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CodeBlock from '../components/CodeBlock.astro';
import FaqList from '../components/FaqList.astro';
import IconGrid from '../components/IconGrid.astro';
import InteractionDemo from '../components/InteractionDemo';
import { alternatesOf, type Locale, localize, t } from '../i18n';
import Layout from '../layouts/Layout.astro';
import {
  breadcrumbNode,
  categoryPath,
  collectionPageNode,
  interactionFaq,
  interactionPath,
  interactions,
  interactionText,
  pickIcons,
} from '../lib/hubs';
import { faqNode, websiteNode } from '../lib/seo';
import { iconsByInteraction } from '../lib/taxonomy';

interface Props {
  locale: Locale;
  interaction: Interaction;
}

const { locale, interaction } = Astro.props;
const m = t(locale);
const h = m.hubs.interaction;
const c = h.codeText;
const info = m.taxonomy.interactions[interaction];
const items = iconsByInteraction(interaction);
const copy = interactionText(interaction, locale);
const path = interactionPath(interaction);
const href = (p: string) => localize(p, locale);
const faq = interactionFaq(interaction, locale);
const hover = interaction.startsWith('hover');
const en = locale.prefix ? 'en' : undefined;
const crumbs = [
  { name: m.common.crumbs.icons, path: href('/icons') },
  { name: m.common.crumbs.interactions, path: href('/interactions') },
  { name: info.label, path: href(path) },
];

// Another icon given this interaction with the prop.
const [other] = pickIcons(['settings', 'bookmark', 'star']).filter((icon) => icon.interaction !== interaction);
const ex = copy.example;
const imports = (icon: typeof ex) => `import ${icon.exportName} from 'react-useanimations/lib/${icon.name}';`;
const overrideCode = `import UseAnimations from 'react-useanimations';
${imports(other)}

// ${h.normallyUses(other.title, other.interaction)}
<UseAnimations animation={${other.exportName}} interaction="${interaction}" size={32} />`;

const code: Record<Interaction, string> = {
  loop: `${imports(ex)}

<UseAnimations animation={${ex.exportName}} speed={0.5} />      // ${c.halfSpeed}
<UseAnimations animation={${ex.exportName}} loop={false} />     // ${c.playsOnce}
<UseAnimations animation={${ex.exportName}} autoplay={false} /> // ${c.staticFrame}`,
  'click-toggle': `import { useState } from 'react';
${imports(ex)}

export function MenuButton() {
  const [open, setOpen] = useState(false);
  return (
    <UseAnimations
      animation={${ex.exportName}}
      active={open} // ${c.endState}
      onClick={() => setOpen(!open)}
      aria-label={open ? '${c.closeMenu}' : '${c.openMenu}'}
    />
  );
}`,
  'click-replay': `${imports(ex)}

<UseAnimations
  animation={${ex.exportName}}
  size={24}
  onClick={handleDownload}
  render={(eventProps, animationProps) => (
    <button type="button" aria-label="${c.download}" {...eventProps}>
      <span {...animationProps} />
    </button>
  )}
/>`,
  hover: `${imports(ex)}

<UseAnimations
  animation={${ex.exportName}}
  render={(eventProps, animationProps) => (
    <a href="/archive" {...eventProps}>
      <span {...animationProps} /> ${c.archive}
    </a>
  )}
/>`,
  'hover-replay': `${imports(ex)}

<UseAnimations
  animation={${ex.exportName}}
  render={(eventProps, animationProps) => (
    <a href="/reports" className="card" {...eventProps}>
      <span {...animationProps} /> ${c.weeklyGrowth}
    </a>
  )}
/>`,
  'hover-loop': `${imports(ex)}

<UseAnimations
  animation={${ex.exportName}}
  speed={1.5}
  render={(eventProps, animationProps) => (
    <a href="https://github.com/useAnimations" aria-label="GitHub" {...eventProps}>
      <span {...animationProps} />
    </a>
  )}
/>`,
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    collectionPageNode(href(path), info.title, copy.description, items, locale),
    breadcrumbNode(crumbs),
    faqNode(faq),
    websiteNode(),
  ],
};
---


<Layout title={copy.title} description={copy.description} path={href(path)} locale={locale} alternates={alternatesOf(path)} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
    <Breadcrumbs crumbs={crumbs} label={m.common.breadcrumb} />

    <div class="mt-8 grid items-start gap-10 lg:grid-cols-[1fr_20rem]">
      <header class="max-w-3xl">
        <p class="text-sm font-medium text-accent">
          {m.hubs.iconCount(items.length)} · <code class="font-mono">interaction="{interaction}"</code>
        </p>
        <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{info.title}</h1>
        <p class="mt-4 text-lg leading-relaxed text-muted">{info.intro}</p>
      </header>
      <InteractionDemo
        client:visible
        id={ex.id}
        interaction={interaction}
        title={ex.title}
        description={info.description}
        hint={info.description}
      />
    </div>

    <section class="mt-12" aria-labelledby="icons-title">
      <h2 id="icons-title" class="text-lg font-semibold">{h.allIcons(info.label)}</h2>
      <IconGrid class="mt-4" icons={items} locale={locale} />
    </section>

    <div class="mt-16 grid gap-12 lg:grid-cols-2">
      <section aria-labelledby="behaviour-title">
        <h2 id="behaviour-title" class="text-2xl font-semibold tracking-tight">{h.behaviour}</h2>
        <p class="mt-4 leading-relaxed text-muted">{info.description}</p>
        <p class="mt-3 leading-relaxed text-muted">
          {info.reducedMotion}
          {hover && h.hoverNote}{' '}
          {h.handled}
        </p>
        <h3 class="mt-8 font-semibold">{h.whereToUse}</h3>
        <ul class="mt-3 list-disc space-y-2 pl-5 text-muted marker:text-subtle">
          {info.useCases.map((useCase) => <li>{useCase}</li>)}
        </ul>
      </section>

      <section aria-labelledby="by-category-title">
        <h2 id="by-category-title" class="text-2xl font-semibold tracking-tight">{h.byCategory}</h2>
        <ul class="mt-4 space-y-3">
          {
            copy.byCategory.map(({ meta: category, icons: group }) => (
              <li>
                <a href={href(categoryPath(category))} class="font-medium text-fg underline-offset-4 hover:underline">{m.taxonomy.categories[category.name].name}</a>
                <span class="text-subtle"> · {group.length}</span>
                <p class="mt-0.5 text-sm text-muted" lang={en}>{group.map((icon) => icon.title).join(', ')}</p>
              </li>
            ))
          }
        </ul>
      </section>
    </div>

    <section class="mt-16 max-w-3xl" aria-labelledby="code-title">
      <h2 id="code-title" class="text-2xl font-semibold tracking-tight">{h.useInReact}</h2>
      <p class="mt-3 leading-relaxed text-muted" set:html={h.overrideHtml} />
      <CodeBlock class="mt-4" lang="jsx" code={overrideCode} track={{ icon: other.id, code: 'interaction' }} locale={locale} />
      <p class="mt-6 leading-relaxed text-muted">{h.extra[interaction]}</p>
      <CodeBlock class="mt-3" lang="jsx" code={code[interaction]} track={{ icon: ex.id, code: 'react' }} locale={locale} />
      <p class="mt-6 leading-relaxed text-muted" set:html={h.docsHtml(href('/documentation#props'), href('/lottie-icons'))} />
    </section>

    <FaqList class="mt-16" faq={faq} title={m.common.faq} />

    <nav aria-labelledby="more-title" class="mt-16 border-t border-line pt-8">
      <h2 id="more-title" class="text-lg font-semibold">{h.other}</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          interactions()
            .filter((group) => group.interaction !== interaction)
            .map((group) => (
              <li>
                <a href={href(interactionPath(group.interaction))} class="inline-flex rounded-full border border-line px-3.5 py-1.5 text-sm text-muted transition hover:border-line-strong hover:text-fg">
                  {m.taxonomy.interactions[group.interaction].label} <span class="ml-1.5 text-subtle">{group.icons.length}</span>
                </a>
              </li>
            ))
        }
        <li>
          <a href={href('/categories')} class="inline-flex rounded-full bg-fg px-3.5 py-1.5 text-sm font-medium text-bg hover:opacity-85">{h.browseByCategory}</a>
        </li>
      </ul>
    </nav>
  </div>
</Layout>
