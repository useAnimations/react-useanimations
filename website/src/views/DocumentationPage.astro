---
// The documentation (/documentation) in any language; src/pages routes render it.
import { alternatesOf, type Locale, localize, t } from '../i18n';
import ControlIcon from '../components/ControlIcon';
import Layout from '../layouts/Layout.astro';
import { lastModifiedOf } from '../lib/git';
import { icons, SITE } from '../lib/icons';
import { documentationIn } from '../lib/markdown';
import { faqNode } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale);
const path = '/documentation';
const href = (p: string) => localize(p, locale);
const body = await documentationIn(locale);
const toc = body.headings.filter((heading) => heading.depth === 2);
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      headline: m.docs.headline,
      description: m.docs.summary,
      url: `${SITE}${href(path)}`,
      inLanguage: body.fallback ? 'en' : locale.hreflang,
      // The last commit to the documentation, not the build date; omitted without Git history.
      dateModified: lastModifiedOf([body.file])?.slice(0, 10),
      publisher: { '@type': 'Organization', name: 'useAnimations', url: `${SITE}/` },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'useAnimations', item: `${SITE}${href('/')}` },
        { '@type': 'ListItem', position: 2, name: m.docs.crumb, item: `${SITE}${href(path)}` },
      ],
    },
    faqNode(m.docs.faq),
  ],
};
const markdown = locale.prefix ? [] : [{ rel: 'alternate', type: 'text/markdown', href: '/documentation.md', title: 'Documentation (Markdown)' }];
---


<Layout
  title={m.docs.title}
  description={m.docs.description(icons.length)}
  path={href(path)}
  locale={locale}
  alternates={alternatesOf(path)}
  head={markdown}
  jsonLd={jsonLd}
>
  <div class="mx-auto grid max-w-7xl gap-12 px-5 pt-14 sm:px-8 lg:grid-cols-[14rem_minmax(0,1fr)] xl:grid-cols-[14rem_minmax(0,46rem)_1fr]">
    <aside class="lg:sticky lg:top-24 lg:max-h-[calc(100vh-7rem)] lg:self-start lg:overflow-y-auto">
      <details class="group rounded-2xl border border-line p-4 lg:border-0 lg:p-0" open>
        <summary
          class="flex cursor-pointer list-none items-center justify-between text-sm font-medium text-fg lg:pointer-events-none [&::-webkit-details-marker]:hidden"
        >
          {m.docs.onThisPage}<ControlIcon client:idle icon="chevronDown" on="open" className="text-subtle lg:hidden" />
        </summary>
        <nav aria-label={m.docs.onThisPage} class="mt-3">
          <ul class="space-y-0.5 border-l border-line">
            {
              toc.map((heading) => (
                <li>
                  <a
                    href={`#${heading.slug}`}
                    data-toc={heading.slug}
                    class="-ml-px block border-l border-transparent py-1 pl-4 text-sm text-muted transition-colors hover:text-fg data-[active]:border-accent data-[active]:text-fg"
                  >
                    {heading.text}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        {!locale.prefix && <a href="/documentation.md" class="mt-6 hidden pl-4 text-xs text-subtle hover:text-fg lg:block">{m.docs.viewAsMarkdown}</a>}
      </details>
    </aside>
    <article class="prose min-w-0 pb-10" data-copy-text={m.common.copy}>
      <p class="mb-2 text-sm font-medium text-accent">{m.docs.badge}</p>
      {body.fallback ? <div lang="en" set:html={body.html} /> : <Fragment set:html={body.html} />}
    </article>
  </div>
</Layout>

<script>
  import { createElement } from 'react';
  import { createRoot } from 'react-dom/client';
  import ControlIcon from '../components/ControlIcon';

  // Highlights the section being read in the table of contents.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((link) => [link.dataset.toc!, link])
  );
  const headings = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
  const update = () => {
    let current = headings[0];
    for (const heading of headings) if (heading.getBoundingClientRect().top < 140) current = heading;
    for (const [id, link] of links) link.toggleAttribute('data-active', id === current?.id);
  };
  addEventListener('scroll', update, { passive: true });
  update();

  // Copy buttons on code blocks.
  for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
    const wrapper = document.createElement('div');
    wrapper.className = 'group/code relative';
    wrapper.dataset.copyScope = '';
    pre.replaceWith(wrapper);
    wrapper.append(pre);
    pre.dataset.code = '';
    const button = document.createElement('button');
    button.type = 'button';
    button.dataset.copyFrom = '[data-code]';
    button.dataset.track = 'copy';
    button.dataset.trackCode = pre.dataset.language ?? 'docs';
    button.className =
      'absolute top-2 right-2 inline-flex items-center gap-1 rounded-lg border border-line bg-surface px-2 py-1 text-xs text-muted opacity-0 transition group-hover/code:opacity-100 focus:opacity-100 data-[copied]:text-accent';
    const icon = document.createElement('span');
    icon.className = 'contents';
    createRoot(icon).render(createElement(ControlIcon, { icon: 'copy', copied: 'checkmark', size: 14 }));
    const label = document.createElement('span');
    label.dataset.copyLabel = '';
    label.textContent = pre.closest<HTMLElement>('[data-copy-text]')?.dataset.copyText ?? 'Copy';
    button.append(icon, label);
    wrapper.append(button);
  }
</script>
