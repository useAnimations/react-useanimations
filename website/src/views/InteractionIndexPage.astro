---
// The list of interactions (/interactions) in any language; src/pages routes render it.
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IconStill from '../components/IconStill.astro';
import { alternatesOf, type Locale, localize, t } from '../i18n';
import Layout from '../layouts/Layout.astro';
import { breadcrumbNode, interactionPath, interactions, localDescription, localTitle } from '../lib/hubs';
import { icons, SITE } from '../lib/icons';
import { websiteNode, WEBSITE_ID } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale);
const p = m.pages.interactions;
const href = (path: string) => localize(path, locale);
const path = '/interactions';
const all = interactions();
const title = localTitle(locale, p.titles);
const description = localDescription(locale, p.descriptions(icons.length, all.length));
const crumbs = [
  { name: m.common.crumbs.icons, path: href('/icons') },
  { name: m.common.crumbs.interactions, path: href(path) },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${SITE}${href(path)}`,
      url: `${SITE}${href(path)}`,
      name: p.title,
      description,
      inLanguage: locale.hreflang,
      isPartOf: { '@id': WEBSITE_ID },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: all.length,
        itemListElement: all.map(({ interaction }, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: `${SITE}${href(interactionPath(interaction))}`,
          name: m.taxonomy.interactions[interaction].title,
        })),
      },
    },
    breadcrumbNode(crumbs),
    websiteNode(),
  ],
};
---

<Layout title={title} description={description} path={href(path)} locale={locale} alternates={alternatesOf(path)} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
    <Breadcrumbs crumbs={crumbs} label={m.common.breadcrumb} />
    <header class="mt-8 max-w-3xl">
      <p class="text-sm font-medium text-accent">{p.badge(all.length, icons.length)}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{p.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted" set:html={p.introHtml} />
    </header>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        all.map(({ interaction, icons: group }) => (
          <li>
            <a
              href={href(interactionPath(interaction))}
              class="group flex h-full flex-col rounded-3xl border border-line bg-surface p-6 transition hover:border-line-strong"
            >
              <span class="flex gap-2 text-fg" aria-hidden="true">
                {group.slice(0, 5).map((icon) => (
                  <IconStill icon={icon} class="size-8" />
                ))}
              </span>
              <span class="mt-5 font-mono text-xs text-accent">interaction="{interaction}"</span>
              <span class="mt-2 flex items-baseline justify-between gap-3">
                <span class="text-lg font-semibold tracking-tight text-fg">{m.taxonomy.interactions[interaction].title}</span>
                <span class="shrink-0 text-sm text-subtle">{p.iconCount(group.length)}</span>
              </span>
              <span class="mt-2 text-sm leading-relaxed text-muted">{m.taxonomy.interactions[interaction].description}</span>
              <span class="mt-2 text-sm leading-relaxed text-subtle">{m.taxonomy.interactions[interaction].example}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="mt-16 grid max-w-5xl gap-12 lg:grid-cols-2">
      <section aria-labelledby="choose-title">
        <h2 id="choose-title" class="text-2xl font-semibold tracking-tight">{p.chooseTitle}</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed text-muted marker:text-subtle">
          {all.map(({ interaction }) => <li set:html={p.chooseHtml[interaction](href(interactionPath(interaction)))} />)}
        </ul>
      </section>
      <section aria-labelledby="motion-title">
        <h2 id="motion-title" class="text-2xl font-semibold tracking-tight">{p.motionTitle}</h2>
        <p class="mt-4 leading-relaxed text-muted" set:html={p.motionHtml} />
        <ul class="mt-4 space-y-2 text-sm leading-relaxed text-muted">
          {all.map(({ interaction }) => (
            <li><code class="font-mono text-fg">{interaction}</code>: {p.reducedMotion[interaction]}</li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</Layout>
