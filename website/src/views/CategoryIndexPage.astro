---
// The list of categories (/categories) in any language; src/pages routes render it.
import Breadcrumbs from '../components/Breadcrumbs.astro';
import IconStill from '../components/IconStill.astro';
import { alternatesOf, type Locale, localize, t } from '../i18n';
import Layout from '../layouts/Layout.astro';
import { breadcrumbNode, categories, categoryPath, localDescription, localTitle } from '../lib/hubs';
import { icons, SITE } from '../lib/icons';
import { websiteNode, WEBSITE_ID } from '../lib/seo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const m = t(locale);
const p = m.pages.categories;
const href = (path: string) => localize(path, locale);
const path = '/categories';
const all = categories();
const title = localTitle(locale, p.titles(all.length));
const description = localDescription(locale, p.descriptions(icons.length, all.length));
const crumbs = [
  { name: m.common.crumbs.icons, path: href('/icons') },
  { name: m.common.crumbs.categories, path: href(path) },
];
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      '@id': `${SITE}${href(path)}`,
      url: `${SITE}${href(path)}`,
      name: p.title,
      description,
      inLanguage: locale.hreflang,
      isPartOf: { '@id': WEBSITE_ID },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: all.length,
        itemListElement: all.map(({ meta }, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          url: `${SITE}${href(categoryPath(meta))}`,
          name: m.taxonomy.categories[meta.name].title,
        })),
      },
    },
    breadcrumbNode(crumbs),
    websiteNode(),
  ],
};
---

<Layout title={title} description={description} path={href(path)} locale={locale} alternates={alternatesOf(path)} jsonLd={jsonLd}>
  <div class="mx-auto max-w-6xl px-5 pt-10 sm:px-8">
    <Breadcrumbs crumbs={crumbs} label={m.common.breadcrumb} />
    <header class="mt-8 max-w-3xl">
      <p class="text-sm font-medium text-accent">{p.badge(icons.length, all.length)}</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{p.title}</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted" set:html={p.introHtml(href('/interactions'))} />
    </header>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        all.map(({ meta, icons: group }) => (
          <li>
            <a
              href={href(categoryPath(meta))}
              class="group flex h-full flex-col rounded-3xl border border-line bg-surface p-6 transition hover:border-line-strong"
            >
              <span class="flex gap-2 text-fg" aria-hidden="true">
                {group.slice(0, 5).map((icon) => (
                  <IconStill icon={icon} class="size-8" />
                ))}
              </span>
              <span class="mt-5 flex items-baseline justify-between gap-3">
                <span class="text-lg font-semibold tracking-tight text-fg">{m.taxonomy.categories[meta.name].name}</span>
                <span class="text-sm text-subtle">{p.iconCount(group.length)}</span>
              </span>
              <span class="mt-2 line-clamp-3 text-sm leading-relaxed text-muted">{m.taxonomy.categories[meta.name].intro}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
