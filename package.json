{
  "name": "react-useanimations",
  "version": "3.0.0-beta.1",
  "private": true,
  "description": "Official React component for useAnimations animated Lottie icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useAnimations/react-useanimations.git"
  },
  "author": "Tuan Phung, Marek Feikus",
  "license": "SEE LICENSE IN LICENSE",
  "bugs": {
    "url": "https://github.com/useAnimations/react-useanimations/issues"
  },
  "homepage": "https://useanimations.com/documentation#react",
  "keywords": [
    "react",
    "lottie",
    "animated-icons",
    "icons",
    "microanimations",
    "svg",
    "useanimations"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "node scripts/clean-dist.mjs",
    "build": "tsup && node scripts/prepare-dist.mjs",
    "sync-icons": "node scripts/sync-icons.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "node scripts/pack.mjs",
    "release": "npm run lint && npm run check-types && npm test && npm run build && npm run pack"
  },
  "dependencies": {
    "lottie-web": "^5.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "^7.7.3",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "react": ">=16.8",
    "react-dom": ">=16.8"
  },
  "engines": {
    "node": ">=20"
  }
}
