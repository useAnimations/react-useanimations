{
  "name": "react-useanimations",
  "version": "3.0.0-beta.2",
  "private": true,
  "description": "Official React component for useAnimations animated Lottie icons",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/useAnimations/react-useanimations.git"
  },
  "author": "Tuan Phung, Marek Feikus",
  "license": "MIT",
  "type": "module",
  "bugs": {
    "url": "https://github.com/useAnimations/react-useanimations/issues"
  },
  "homepage": "https://useanimations.com/documentation#react",
  "keywords": [
    "react",
    "lottie",
    "animated-icons",
    "icons",
    "microanimations",
    "svg",
    "useanimations"
  ],
  "sideEffects": false,
  "scripts": {
    "prebuild": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsdown && node scripts/prepare-dist.ts",
    "sync-icons": "node scripts/sync-icons.ts",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "node scripts/pack.ts",
    "verify": "npm run lint && npm run check-types && npm test && npm run build && npm run pack"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/semver": "^7.8.0",
    "@vitest/browser-playwright": "^5.0.3",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "playwright": "^1.64.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "semver": "^7.7.3",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  }
}
